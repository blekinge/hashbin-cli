<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.hashbin</groupId>
  <artifactId>hashbin-cli</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>quarkus</packaging>
  <name>Hashbin CLI</name>
  <description>Command line client for the hashbin.net trusted file-timestamping service (Quarkus Picocli)</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <compiler-plugin.version>3.15.0</compiler-plugin.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <!-- Aligned with the ARK quarkus-templates/commandline template. -->
    <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
    <surefire-plugin.version>3.5.6</surefire-plugin.version>
    <jacoco-plugin.version>0.8.16</jacoco-plugin.version>
    <spotless-plugin.version>2.44.4</spotless-plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <lombok.version>1.18.48</lombok.version>
    <assertj.version>3.27.7</assertj.version>
    <skipITs>false</skipITs>
    <!-- The hashbin REST client lives in the sibling backend repo, GENERATED at
         the backend's build time from its own OpenAPI document (net.hashbin.api.*).
         Consumed here as a Maven dependency so the wire contract cannot drift. -->
    <hashbin-api.version>1.0.0-SNAPSHOT</hashbin-api.version>
  </properties>

  <!-- Resolution source for net.hashbin:hashbin-api at CI build time: the sibling backend repo
       publishes it here (see its ci/Jenkinsfile 'Publish API artifact' stage). Declared in the pom
       rather than settings.xml because it needs NO authentication (the ARK template rule: pom
       <repositories> for unauthenticated repos, settings.xml for anything with credentials). Also
       serves releases once the project is versioned. Locally the artifact usually resolves from
       ~/.m2 via a sibling checkout instead (README "Requirements"). -->
  <repositories>
    <repository>
      <id>sbforge-nexus</id>
      <url>https://sbforge.org/nexus/content/groups/public</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Picocli command-line runtime (brings quarkus-picocli + picocli + arc). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-picocli</artifactId>
    </dependency>
    <!-- Build/git/java/os metadata backing the version option (VersionProvider). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-info</artifactId>
    </dependency>
    <!-- CDI container (command instances are created through the Picocli CDI factory). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>

    <!-- JSON parsing/serialization for the wire contract (snake_case). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jackson</artifactId>
    </dependency>

    <!-- The hashbin REST client: a MicroProfile REST Client interface + Jackson
         models generated from the backend's live OpenAPI contract. -->
    <dependency>
      <groupId>net.hashbin</groupId>
      <artifactId>hashbin-api</artifactId>
      <version>${hashbin-api.version}</version>
    </dependency>

    <!-- Runtime implementation for the MicroProfile REST Client interfaces that
         hashbin-api only supplies the API for (those jars are `provided`). The
         Jackson variant registers JSON body readers/writers so the generated
         models (de)serialize over the wire. Quarkus supplies the GraalVM-native
         wiring, keeping the CLI binary buildable. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>compile</scope>
    </dependency>

    <!-- NOTE: intentionally NO quarkus-rest / quarkus-undertow: a Picocli CLI must
         boot, run one command and exit, with no HTTP server on the classpath. Outbound
         calls go through the MicroProfile REST Client (hashbin-api) backed by this. -->

    <!-- Test -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>.</directory>
        <!-- Bundled so the optional `license` / `changelog` subcommands (LicenseCommand /
             ChangelogCommand) can print them; needed in JVM mode and, with their
             @RegisterResources, in the native image. Delete this block with those commands
             if the CLI ever stops shipping them. -->
        <includes>
          <include>LICENSE.txt</include>
          <include>CHANGELOG.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Source formatting: google-java-format in AOSP style (4-space indent).
           `mvn spotless:apply` reformats; the `check` goal (bound to verify) fails the
           build if anything drifts. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-plugin.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <argLine>@{argLine}</argLine>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
            <!-- Enables the auto-detected root extensions (TestMethodReporter,
                 QuietLaunchExtension; META-INF/services registration). -->
            <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <argLine>@{argLine}</argLine>
          <systemPropertyVariables>
            <native.image.path>${project.build.directory}/${project.build.finalName}</native.image.path>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
            <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- Code coverage: prepare-agent sets the @{argLine} surefire/failsafe use;
           report writes target/site/jacoco after the unit tests. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-plugin.version}</version>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>default-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Native binary for a snappy CLI. Activate with -Pnative (or -Dnative), which
         also enables the failsafe integration tests against the built native image.
         By default this builds with a local GraalVM/Mandrel toolchain (native-image on
         PATH). To build inside a container with no local install, add
         -Dquarkus.native.container-build=true. Mirrors the ARK commandline template. -->
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
  </profiles>
</project>
